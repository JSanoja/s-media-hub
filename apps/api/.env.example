# Copiar a .env (no se versiona). Todo es opcional: los valores de abajo son los defaults.
# Las rutas relativas se resuelven contra la carpeta apps/api.

# --- Red: cómo escucha la API ---
PROTOCOL=http
HOST=0.0.0.0
PORT=3000

# --- Red: cómo la ven el front y el Chromecast ---
# Si PUBLIC_HOST queda vacío se autodetecta la IPv4 de la LAN (ej. 192.168.0.50).
# Recomendado: fijarla (y reservarla en el router) para que la URL no cambie.
PUBLIC_HOST=
# PUBLIC_PORT=3000
# Override completo (gana sobre PROTOCOL/PUBLIC_HOST/PUBLIC_PORT):
# PUBLIC_BASE_URL=http://192.168.0.50:3000

# --- HTTPS (solo si PROTOCOL=https) ---
# TLS_CERT=certs/fullchain.pem
# TLS_KEY=certs/privkey.pem

# --- Biblioteca y cache ---
# Carpeta con las películas/series (solo lectura). Puede ser absoluta: D:\Videos
MEDIA_ROOT=public/source
# Miniaturas, transcodes, base de datos. No puede estar dentro de MEDIA_ROOT.
CACHE_DIR=../../cache

# --- Perfiles (WU-21) ---
# PINs con los que se crean los perfiles la primera vez (después se cambian desde la app).
# PROFILE_PINS=obi:7890,papas:5555,invitados:1111

# --- Dispositivos (WU-19) ---
# Segundos sin heartbeat para dejar de considerar activo un dispositivo (la app manda uno cada 60 s).
# DEVICE_ACTIVE_SECONDS=120

# --- Interfaz de TV (build de apps/tv, se sirve en /tv/) ---
# TV_DIR=../tv/dist

# --- Chromecast ---
# CC1AD845 = Default Media Receiver de Google. Cambiar por el App ID propio en WU-12.
CAST_RECEIVER_APP_ID=CC1AD845
CORS_ORIGINS=*

# --- Varios ---
# FFMPEG_PATH=
# FFPROBE_PATH=
LOG_FORMAT=dev
