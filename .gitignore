# Dependencias y builds
node_modules/
dist/
coverage/

# Entorno (nunca versionar secretos ni IPs propias)
.env
.env.*
!.env.example

# Datos locales
cache/
*.sqlite
*.sqlite-*
*.db
*.db-wal
*.db-shm
logs/
*.log

# Certificados (si algún día se pasa a HTTPS)
